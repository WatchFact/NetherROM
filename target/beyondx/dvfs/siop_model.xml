<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (default, complex?)>
<!ELEMENT default (component+)>
<!ELEMENT complex (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <LTB formula="AP*BAT" temp="510.450" />
            <SS  formula="AP*BAT*PA" temp="580.490.530" />
            <GDM formula="AP*BAT" temp="470.440" delta="10"/>
            <GDMLTB formula="AP*BAT" temp="490.460"/>
            <DEX formula="AP*BAT" temp="550.450" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="AP"/>
        <temperatures>
            <temp type="AP"   default="15" min="15" max="15" step="0" gap="120" />
        </temperatures>
        <levels>
            <level id="-3" temp="420" />
            <level id="-2" temp="440" />
            <level id="-1" temp="460" />
            <level id="0"  temp="480" />
            <level id="1"  temp="500" />
            <level id="2"  temp="520" />
            <level id="3"  temp="540" />
            <level id="4"  temp="560" />
            <level id="5"  temp="580" />
            <level id="6"  temp="650" />
            <level id="7"  temp="700" />
        </levels>
        <sensors>
            <LTB_SENSOR type="(PALM*LIGHT*FLICKER)+(POSITION*LIGHT*FLICKER)" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="470:500" value="-1:1378000" />
            <limiter name="GPUFreqMax" step="0" temp="470:500" value="-1:377000" />
            <limiter name="AppInstallDelay" value="5000" />
            <limiter name="BackgroundCpuset" temp="480" gap="20" value="-1:100:200:300" />
            <limiter name="TABoost"      temp="520" value="-1:1" />
        </component>

        <component name="DISPLAY" tempType="AP*LRP">
            <limiter name="Brightness" temp="510.390:530.410:550.430" value="-1:201:144" />
            <limiter name="MultiWindow" temp="570.450:590.470:620.500" value="-1:1:1" delay="0:300:0" />
        </component>

        <component name="CP" tempType="LRP">
            <limiter name="CpLowMode" temp="410:430" value="-1:1" />
        </component>

    </components>

    <scenarios>

        <scenario name="TPBoost:com.FTATS" tempType="SKIN" >
            <limiter name="CPUFreqMax" value="-1" />
        </scenario>

        <scenario name="Heavyuser" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550" value="-1" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600" value="-1:572000" />
        </scenario>

        <scenario name="AppStore" tempType="SKIN" >
            <limiter name="WifiTput" temp="430:450:470:510:530:550" value="-1:150:100:50:30:10" />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="LowTemp" tempType="BAT" priority="3" >
            <limiter name="CPUFreqMax" temp="-150:-70:-50" value="1378000:1820000:-1" />
        </scenario>

        <scenario name="Navigation" tempType="SKIN" >
            <limiter name="Brightness" temp="530" value="169:144" />
        </scenario>

        <scenario name="MultiWindow" tempType="LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="350"     value="-1:1560000:1560000:1144000:936000" />
        </scenario>

        <scenario name="Dex" tempType="SKIN*LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="470.350:490.370:510.390:530.410:550.430"     value="-1:1560000:1560000:1144000:936000" />
            <limiter name="DynamicFpsLevel"     temp="530.410:550.430"                             value="-1:30"/>
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="1">
            <limiter name="Brightness" temp="530:550" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1:1" />
        </scenario>

        <scenario name="LiveCam" tempType="AP" priority="1">
            <limiter name="Brightness" temp="530:550" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1" />
        </scenario>

        <scenario name="SpayClockLimit" tempType="SKIN" priority="2" >
            <limiter name="CPUFreqMax" value="2080000" />
        </scenario>

        <scenario name="PowerSharing" tempType="SKIN" priority="3" >
            <limiter name="CPUFreqMax" value="1560000" />
            <limiter name="GPUFreqMax" value="377000" />
        </scenario>

        <scenario name="CameraNight!Camera_night" tempType="SKIN">
            <limiter name="CPUFreqMax" value="-1" />
            <limiter name="GPUFreqMax" value="-1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN">
            <limiter name="Brightness" temp="450:470:510:530:550" value="-1:255:255:201:144" />
        </scenario>

        <scenario name="HeadMountedTheater" tempType="SKIN">
            <limiter name="CPUFreqMax" temp="450:565:570" value="-1:289250:30468"  />
            <limiter name="GPUFreqMax" temp="450:565:570" value="-1:260000:200000" />
            <limiter name="HmtLevel"   temp="450:565:570" value="-1:1:2"           />
        </scenario>

        <scenario name="HeadMountedTheater_2" tempType="SKIN">
            <limiter name="CPUFreqMax" temp="450:565:570" value="-1:289250:30468"  />
            <limiter name="GPUFreqMax" temp="450:565:570" value="-1:260000:200000" />
            <limiter name="HmtLevel"   temp="450:565:570" value="-1:1:2"           />
        </scenario>

        <scenario name="SmartSwitch" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="470:500" value="2236000:1378000" />
        </scenario>

        <scenario name="AbusiveApp" tempType="SKIN" priority="1">
            <limiter name="CPUFreqMax" temp="340" value="1664000:1560000:1040000:819000" />
            <limiter name="GPUFreqMax"            value="325000" />
            <limiter name="Brightness" temp="410:430:530:550" value="224:169:169:104" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-7"  limiter="CPUFreqMax"                             value="728000" />
            <scenario id="-6"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:728000" />
            <scenario id="-5"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:819000" />
            <scenario id="-4"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:936000" />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:1040000" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:1144000" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1378000:1248000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1456000:1378000" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1560000:1456000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1664000:1560000" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="490:500:520" value="-1:1820000:1664000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1" />
            <scenario name="BackgroundCpuset" temp="500:520:540" value="100:200:300" />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN*BAT*PA" >
            <scenario id="-3" limiter="GPUFreqMax"                                         value="260000" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="490.0.0:500.0.0:520.0.0" value="-1:325000:260000" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="490.0.0:500.0.0:520.0.0" value="-1:377000:325000" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="490.0.0:500.0.0:520.0.0" value="-1:433000:377000" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="490.0.0:500.0.0:520.0.0" value="-1:572000:433000" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="490.0.0:500.0.0:520.0.0" value="-1:702000:572000" />
            <scenario id="3"  limiter="GPUFreqMax"                                         value="-1" />
        </scenario_group>

    </scenarios>

</siop_document>
